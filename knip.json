{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "remix": true,
  "lefthook": true,
  "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}", "!base-stack/**"],
  "ignore": [
    "generated/**",
    "app/sw.ts",
    "app/welcome/**",
    "app/components/ui/**",
    "app/lib/db.server.ts",
    "app/lib/utils.ts"
  ],
  "ignoreDependencies": [
    "clsx",
    "tailwind-merge",
    "@base-ui/react",
    "@epic-web/client-hints",
    "@fontsource-variable/figtree",
    "@hugeicons/core-free-icons",
    "@hugeicons/react",
    "@react-pdf/renderer",
    "class-variance-authority",
    "i18next-browser-languagedetector",
    "i18next-http-backend",
    "pretty-cache-header",
    "shadcn",
    "signature_pad",
    "tailwindcss",
    "tw-animate-css",
    "workbox-precaching",
    "workbox-routing",
    "workbox-strategies"
  ]
}
