// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum Role {
  SUPERVISOR
  CREW
  WAREHOUSE
  FINANCE
  ADMIN
  INSTALLER
  COMPTROLLER
  INSTALLER_SUPERVISOR
}

enum DocStatus {
  CREATED
  PREPPED
  SIGNED
  FIELD_UPDATED
  SUPERVISOR_APPROVED
  CLARO_UPLOADED
  LC_REQUEST_GENERATED
  CANCELLED
}

enum PaymentType {
  PBCC_ADVANCE
  CREW_PAYMENT
  CLARO_FINAL
}

enum PhotoTag {
  BEFORE
  AFTER
  DURING
}

enum PacketSendOutcome {
  SENT
  FAILED
  UNCONFIGURED
  MANUAL
}

enum CatalogKind {
  SERVICE
  MATERIAL
}

enum Ownership {
  CLARO_CONSIGNED
  JAF_PURCHASED
  UNKNOWN
}

enum SerialStatus {
  WAREHOUSE
  VAN
  INSTALLED
  REMOVED_PENDING_RETURN
  RETURNED
  SENT_FOR_REPAIR
  NEEDS_REVIEW
  AWAITING_REPAIR
  LOST
}

enum StockMovementType {
  PICKUP
  INSTALL
  SWAP_OUT
  SWAP_IN
  RETURN
  ADJUST
  RECEIVE
  RELEASE
  STARTING_BALANCE
  DISPOSITION
  SENT_FOR_REPAIR
  REPAIR_INTAKE
}

enum MovementKind {
  SERIAL
  BULK
}

enum SerialCondition {
  NEW
  REFURBISHED
}

enum RepairBatchStatus {
  SENT
  VOIDED
}

enum CompletionStatus {
  DRAFT
  SUBMITTED
}

enum SwapReason {
  HARDWARE
  INSTALL_DEFECT
  CUSTOMER
  LINE
  OTHER
}

enum PaymentRequestKind {
  INSTALL
  CALLBACK
}

enum PaymentRequestStatus {
  INCOMPLETE
  READY
  PAID
}

enum RestockStatus {
  DRAFT
  SUBMITTED
  NEEDS_SIGNOFF
  APPROVED
  PICKED
  RECEIVED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Admin-managed: the areas a SUPERVISOR is authorized to act in. This is
  // the sole source of a supervisor's authorization scope — never derive it
  // from Brigade.area/supervisorId, which are ordinary editable fields, not
  // an identity/authorization record. See supervisorAreas() in
  // app/lib/supervisor-scope.ts.
  supervisorAreas String[] @default([])

  // better-auth relations
  sessions Session[]
  accounts Account[]

  supervisedInvoices        JafInvoice[]          @relation("SupervisorDocs")
  preppedInvoices           JafInvoice[]          @relation("PreppedDocs")
  releasedInvoices          JafInvoice[]          @relation("ReleasedDocs")
  signedInvoices            JafInvoice[]          @relation("SignedDocs")
  completedInvoices         JafInvoice[]          @relation("CompletedDocs")
  overriddenInvoices        JafInvoice[]          @relation("OverriddenDocs")
  lcApprovedInvoices        JafInvoice[]          @relation("LcApprovedDocs")
  financeVerifiedInvoices   JafInvoice[]          @relation("FinanceVerifiedDocs")
  closedReceivables         JafInvoice[]          @relation("ClosedReceivables")
  cancelledInvoices         JafInvoice[]          @relation("CancelledDocs")
  supervisedBrigades        Brigade[]             @relation("BrigadeSupervisor")
  releasedToFinanceInvoices JafInvoice[]          @relation("ReleasedToFinanceDocs")
  installedVan              Van?                  @relation("VanInstaller")
  systemSettings            SystemSetting[]       @relation("SystemSettings")
  auditTrail                AuditTrail[]
  photos                    Photo[]
  notifications             Notification[]
  paymentRecords            PaymentRecord[]
  preCertSheets             PreCertSheet[]
  warehouseAssignments      WarehouseAssignment[]

  installerProfile    InstallerProfile?   @relation("InstallerProfile")
  stockMovements      StockMovement[]     @relation("StockMovements")
  installCompletions  InstallCompletion[] @relation("InstallerCompletions")
  installerSwaps      SwapEvent[]         @relation("InstallerSwaps")
  paymentRequests     PaymentRequest[]    @relation("InstallerPaymentRequests")
  paidPaymentRequests PaymentRequest[]    @relation("PaidPaymentRequests")
  restockApprovals    RestockRequest[]    @relation("RestockApprovals")

  // Arm A (payroll) — Finance-Billing Arm A phase, back-relations
  payablesClosedDocs         JafInvoice[]        @relation("PayablesClosedDocs")
  payrollRunGenerator        PayrollRun[]        @relation("PayrollRunGenerator")
  payrollRunSender           PayrollRun[]        @relation("PayrollRunSender")
  claroPosUploaded           ClaroPo[]           @relation("ClaroPoUploader")
  claroPosConfirmed          ClaroPo[]           @relation("ClaroPoConfirmer")
  claroInvoicesMade          ClaroInvoice[]      @relation("ClaroInvoiceMaker")
  claroInvoicesLoaded        ClaroInvoice[]      @relation("ClaroInvoiceLoader")
  claroInvoicesShortAccepted ClaroInvoice[]      @relation("ClaroInvoiceShortAcceptor")
  paymentAdvices             PaymentAdvice[]     @relation("AdviceUploader")
  paymentAdvicesApplied      PaymentAdvice[]     @relation("AdviceApplier")
  payrollRunPaidBy           PayrollRun[]        @relation("PayrollRunPaidBy")
  payrollRunAccountsPaid     PayrollRunAccount[] @relation("PayrollRunAccountPaidBy")
  payrollRunReversedBy       PayrollRun[]        @relation("PayrollRunReversedBy")

  createdRepairBatches    RepairBatch[]   @relation("RepairBatchCreator")
  voidedRepairBatches     RepairBatch[]   @relation("RepairBatchVoider")
  repairIntakesReceived   RepairIntake[]  @relation("RepairIntakeReceiver")
  stockDeliveriesReceived StockDelivery[] @relation("StockDeliveryReceiver")
  stockSnapshotsGenerated StockSnapshot[] @relation("StockSnapshotGenerator")

  bankSchedulesGenerated BankSchedule[] @relation("BankScheduleGenerator")
  bankSchedulesSent      BankSchedule[] @relation("BankScheduleSender")
  bankSchedulesClosed    BankSchedule[] @relation("BankScheduleCloser")

  packetSends PacketSend[] @relation("PacketSendSender")

  @@index([role, active])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([value])
}

model Warehouse {
  id       String  @id @default(cuid())
  name     String
  zone     String
  location String?
  active   Boolean @default(true)

  invoices             JafInvoice[]
  warehouseAssignments WarehouseAssignment[]

  stockMovements  StockMovement[] @relation("WarehouseMovements")
  repairBatches   RepairBatch[]   @relation("WarehouseRepairBatches")
  repairIntakes   RepairIntake[]  @relation("WarehouseRepairIntakes")
  stockDeliveries StockDelivery[] @relation("WarehouseStockDeliveries")
  stockSnapshots  StockSnapshot[] @relation("WarehouseStockSnapshots")

  @@index([active])
}

// Which staff are assigned to which warehouse, and who leads it.
// Consumed by both Warehouse specs; Spec A adds the requireWarehouseLead helper.
model WarehouseAssignment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  isLead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([userId, warehouseId])
  @@index([warehouseId, isLead])
}

model JafInvoice {
  id            String    @id @default(cuid())
  controlNumber String    @unique
  status        DocStatus @default(CREATED)

  // Supervisor fills at intake
  jobType               String
  jobAddressEstimated   String
  estimatedMaterials    Json
  assignedCrewIds       String[]
  crewAssignmentHistory Json? // [{ userIds, assignedById, assignedAt }] — recorded at assignment changes
  supervisorId          String
  supervisor            User     @relation("SupervisorDocs", fields: [supervisorId], references: [id])
  avisoNumber           String?
  createdAt             DateTime @default(now())

  // Warehouse prep (Step 2)
  preppedAt            DateTime?
  preppedById          String?
  preppedBy            User?     @relation("PreppedDocs", fields: [preppedById], references: [id])
  prepChangedSincePrep Boolean   @default(false)
  preppedMaterials     Json?
  materialsReturned    Json?

  // Dual signature at warehouse pickup (Step 3) — materialsTaken locked after this
  // warehouseId set here, not at prep — crew may pull from a different zone warehouse
  warehouseId      String?
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  materialsTaken   Json?
  releaseSignature String? // base64 — warehouse person signs (gives)
  releasedById     String?
  releasedBy       User?      @relation("ReleasedDocs", fields: [releasedById], references: [id])
  releaseSignedAt  DateTime?
  crewSignature    String? // base64 — crew member signs (receives)
  signedById       String?
  signedBy         User?      @relation("SignedDocs", fields: [signedById], references: [id])
  signedAt         DateTime?

  // Admin override
  overriddenById    String?
  overriddenBy      User?     @relation("OverriddenDocs", fields: [overriddenById], references: [id])
  overrideSignature String?
  overrideAt        DateTime?
  overrideReason    String?

  // Cancellation (allowed any time before Finance closes; requires a reason)
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?     @relation("CancelledDocs", fields: [cancelledById], references: [id])

  // Send-back history: Supervisor→Crew and Finance→Supervisor. Array of
  // { fromStatus, toStatus, note, byUserId, createdAt } kept for audit.
  sendBackHistory Json?

  // Crew field update (Step 4)
  jobAddressActual    String?
  addressCorrections  Json? // [{ original, corrected, correctedById, correctedAt, gps? }]
  gpsCoordinates      Json? // { lat, lng, accuracy, capturedAt }
  materialsUsed       Json?
  fieldNotes          String?
  startedAt           DateTime? // time on site start
  endedAt             DateTime? // time on site end
  completionSignature String? // base64 — crew lead signs completion
  completedById       String?
  completedBy         User?     @relation("CompletedDocs", fields: [completedById], references: [id])
  completionSignedAt  DateTime?
  completedAt         DateTime?
  fieldSubmittedAt    DateTime?

  // Supervisor approval + Claro submission (Step 5)
  supervisorApprovedAt DateTime?
  claroNotes           String?
  claroPdfPath         String?
  claroUploadedAt      DateTime?

  // Lissette generates LC (Step 6)
  lcRequestPdfPath String?
  lcGeneratedAt    DateTime?
  lcApprovedById   String?
  lcApprovedBy     User?     @relation("LcApprovedDocs", fields: [lcApprovedById], references: [id])

  // Finance pipeline (Phase 2)
  financeVerifiedAt    DateTime?
  financeVerifiedById  String?
  financeVerifiedBy    User?         @relation("FinanceVerifiedDocs", fields: [financeVerifiedById], references: [id])
  financeSendBackNotes Json? // [{ note, byUserId, createdAt }] — Finance→Supervisor Aviso issues
  pbccRequestPdfPath   String?
  bankInvoicePdfPath   String?
  bankScheduleId       String?
  bankSchedule         BankSchedule? @relation(fields: [bankScheduleId], references: [id])
  pbccRequestSentAt    DateTime?
  karmenCopySentAt     DateTime?
  finalClaroDocPath    String?
  finalClaroUploadedAt DateTime?

  // Payment tracking (receivables dashboard)
  advanceReceivedAt      DateTime?
  advanceAmount          Decimal?
  finalPaymentReceivedAt DateTime?
  finalPaymentAmount     Decimal?
  receivableClosedAt     DateTime?
  receivableClosedById   String?
  receivableClosedBy     User?     @relation("ClosedReceivables", fields: [receivableClosedById], references: [id])

  // Generated documents
  warehouseReceiptPath String?
  jafInvoicePdfPath    String? // supervisor-generated JAF invoice (for the Claro Aviso)

  // Phase 3 - supervisor layer
  brigadeId             String?
  brigade               Brigade?  @relation(fields: [brigadeId], references: [id])
  jobDescription        String?
  serviceLines          Json? // [{ serviceCodeId, claroCode, accountCode, name, qty }] ordered at intake
  installedServiceLines Json? // same shape, crew's installed qty
  jafInvoiceGeneratedAt DateTime?
  jafInvoiceLines       Json? // [{ serviceCodeId, claroCode, accountCode, name, unit, qty, unitPrice, lineAmount }]
  jafInvoiceLineTotal   Decimal? // pre-IVU line sum
  avisoDocPath          String? // uploaded Aviso PDF (distinct from claroPdfPath)
  avisoLines            Json? // [{ serviceCodeId, claroCode, qty, unitPrice, lineAmount }]
  avisoLineTotal        Decimal?
  avisoMatchedAt        DateTime? // set only when the amount gate passes
  contractorAccountCode String? // copied from Brigade.code at sub-contractor signature
  releasedToFinanceAt   DateTime?
  releasedToFinanceById String?
  releasedToFinanceBy   User?     @relation("ReleasedToFinanceDocs", fields: [releasedToFinanceById], references: [id])

  // Arm A (payroll) — Finance-Billing Arm A phase
  payablesClosedAt     DateTime?
  payablesClosedById   String?
  payablesClosedBy     User?              @relation("PayablesClosedDocs", fields: [payablesClosedById], references: [id])
  contractorAccountId  String?
  contractorAccount    ContractorAccount? @relation(fields: [contractorAccountId], references: [id])
  contractorShareLines Json?
  grossPayable         Decimal?
  retentionAmount      Decimal?
  netPayable           Decimal?
  payrollRunId         String?
  payrollRun           PayrollRun?        @relation(fields: [payrollRunId], references: [id])

  // Supervisor workflow redesign
  claroSupervisorId      String?
  claroSupervisor        ClaroSupervisor? @relation(fields: [claroSupervisorId], references: [id])
  sector                 String?
  direccion1             String?
  direccion2             String?
  latitud                String?
  longitud               String?
  tipo                   String?
  ciudad                 String?
  tipoPlanta             String?
  grupoPlan              String?
  ordenNumber            String?
  pedido                 String?
  smr                    String?
  titulo                 String?
  blueprintPaths         String[]         @default([])
  materialsFromWarehouse Boolean          @default(true)
  materialsReason        String?
  prefieldNeeded         Boolean          @default(false)
  prefieldPdfPath        String?
  packetStale            Boolean          @default(false)
  avisoDiscrepancy       Json?
  avisoHistory           Json?
  fieldStartedAt         DateTime?
  fieldMaterials         Json?

  preCertSheets  PreCertSheet[]
  auditTrail     AuditTrail[]
  photos         Photo[]
  poLinks        PoLink[]
  claroPos       ClaroPo[]
  claroInvoices  ClaroInvoice[]
  paymentRecords PaymentRecord[]
  packetSends    PacketSend[]

  @@index([claroSupervisorId])
  @@index([status, lcGeneratedAt])
  @@index([status, financeVerifiedAt, pbccRequestSentAt, advanceReceivedAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([brigadeId])
  @@index([releasedToFinanceAt])
  @@index([payrollRunId])
  @@index([contractorAccountId])
  @@index([bankScheduleId])
  @@index([assignedCrewIds(ops: ArrayOps)], type: Gin)
  @@index([avisoNumber(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([jobAddressEstimated(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("jaf_invoice")
}

model ClaroSupervisor {
  id                String   @id @default(cuid())
  name              String
  email             String
  active            Boolean  @default(true)
  requiresPrefield  Boolean  @default(false)
  requiresBlueprint Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  invoices    JafInvoice[]
  packetSends PacketSend[]
}

model PacketSend {
  id                String            @id @default(cuid())
  docId             String
  doc               JafInvoice        @relation(fields: [docId], references: [id])
  sentAt            DateTime          @default(now())
  sentById          String
  sentBy            User              @relation("PacketSendSender", fields: [sentById], references: [id])
  recipientEmail    String
  claroSupervisorId String?
  claroSupervisor   ClaroSupervisor?  @relation(fields: [claroSupervisorId], references: [id])
  outcome           PacketSendOutcome
  error             String?

  @@index([docId, sentAt])
}

model AuditTrail {
  id        String     @id @default(cuid())
  docId     String
  doc       JafInvoice @relation(fields: [docId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  action    String // e.g. "STATUS_CHANGED", "FIELD_UPDATED"
  diffJson  Json // {field, before, after}
  timestamp DateTime   @default(now())

  @@index([docId, timestamp])
}

model Photo {
  id           String     @id @default(cuid())
  docId        String
  doc          JafInvoice @relation(fields: [docId], references: [id])
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  localPath    String // /var/jaf/uploads/photos/<docId>/<filename>
  takenAt      DateTime   @default(now())
  tag          PhotoTag?

  @@index([docId])
}

model ServiceCode {
  id                String      @id @default(cuid())
  claroCode         String      @unique // e.g. "34006428"
  name              String // catalog description,  e.g. "TRANSFER STITCH DE POSTESMC"
  description       String?
  kind              CatalogKind @default(MATERIAL)
  unit              String? // EA, FT, SQFT, TRAMO (SPAN); null when the catalog has none
  unitPrice         Decimal // = jaf_price (what JAF      invoices Claro)
  claroBasePrice    Decimal?
  upliftFactor      Decimal?
  contractorPrice   Decimal?
  contractorFactor  Decimal?
  priceListRevision String?
  effectiveFrom     DateTime?
  accountCode       String?
  subAct            String?
  dept              String?
  profitCenter      String?
  act               String?
  costCenterCode    String?
  active            Boolean     @default(true)

  // Material-master extensions (Phase 0). All nullable/defaulted so existing rows are untouched.
  ownership        Ownership @default(UNKNOWN) // CLARO_CONSIGNED | JAF_PURCHASED | UNKNOWN — values blocked on Orlando; ships default
  reparadoCode     String? // original SAP code -> its REPARADO claroCode
  countUnit        String? // unit staff physically count in
  stockUnit        String? // unit stock is held/reported in
  conversionFactor Decimal? // countUnit -> stockUnit; 39 rows blocked on Orlando (null => derived stock figure stays hidden)
  canonicalName    String? // one canonical name per SAP code; the 21 alternates stay search-only

  serialized   Boolean @default(false)
  serialPrefix String?

  @@index([kind, active])
}

model PoLink {
  id               String     @id @default(cuid())
  docId            String
  doc              JafInvoice @relation(fields: [docId], references: [id])
  claroPONumber    String
  acceptanceNumber String?
  poDate           DateTime?
  amount           Decimal?
  createdAt        DateTime   @default(now())

  @@index([docId])
}

enum ClaroPoStatus {
  PENDING // uploaded, not read yet
  READING
  READY // every check passed
  NEEDS_LOOK
  BLOCKED
  UNMATCHED // no Aviso found
  CONFIRMED
}

// A purchase order Claro sent, as uploaded to the PO inbox. One row per file;
// lines stay JSON like the JAF invoice's. `docId` is the Aviso it belongs to.
model ClaroPo {
  id              String        @id @default(cuid())
  poNumber        String?
  poDate          DateTime?
  termsDays       Int?
  statedPages     Int? // "1 de 4" -> 4
  filePages       Int? // pages actually in the uploaded PDF
  filePath        String
  fileName        String
  fileHash        String
  status          ClaroPoStatus @default(PENDING)
  docId           String?
  doc             JafInvoice?   @relation(fields: [docId], references: [id])
  avisoCandidates String[]
  lines           Json? // [{ item, description, amount, ivuRate, ivu }]
  subtotal        Decimal?
  ivu4            Decimal?
  ivu115          Decimal?
  total           Decimal?
  checks          Json? // [{ code, severity, detail }]
  readError       String?
  entered         Json? // { field: { byId, at } } for values typed by hand
  receivedAt      DateTime      @default(now())
  readStartedAt   DateTime?
  uploadedById    String
  uploadedBy      User          @relation("ClaroPoUploader", fields: [uploadedById], references: [id])
  confirmedAt     DateTime?
  confirmedById   String?
  confirmedBy     User?         @relation("ClaroPoConfirmer", fields: [confirmedById], references: [id])
  invoice         ClaroInvoice?

  @@index([status, receivedAt])
  @@index([poNumber])
  @@index([docId])
  @@index([fileHash])
}

// The "Factura de Pago - Claro" JAF makes from a confirmed PO and loads in Ariba
// by hand. One PO per invoice. `seq` is the M19 series number: unique, so two
// invoices can never share one.
model ClaroInvoice {
  id                String       @id @default(cuid())
  seq               Int          @unique
  claroPoId         String       @unique
  claroPo           ClaroPo      @relation(fields: [claroPoId], references: [id])
  docId             String
  doc               JafInvoice   @relation(fields: [docId], references: [id])
  workMonth         String // "2026-05"
  subtotal          Decimal
  ivu4              Decimal
  ivu115            Decimal
  total             Decimal
  filePath          String
  madeAt            DateTime     @default(now())
  madeById          String
  madeBy            User         @relation("ClaroInvoiceMaker", fields: [madeById], references: [id])
  loadedAt          DateTime?
  loadedById        String?
  loadedBy          User?        @relation("ClaroInvoiceLoader", fields: [loadedById], references: [id])
  dueDate           DateTime?
  paidAt            DateTime?
  paidNet           Decimal?
  voucherId         String?
  bankReference     String?
  shortReason       String?
  shortAcceptedAt   DateTime?
  shortAcceptedById String?
  shortAcceptedBy   User?        @relation("ClaroInvoiceShortAcceptor", fields: [shortAcceptedById], references: [id])
  adviceLines       AdviceLine[]

  @@index([docId])
  @@index([loadedAt])
}

enum AdviceResult {
  MATCHED
  SHORT
  UNMATCHED
  ALREADY_PAID
}

// Claro's Payment Advice: what it paid and when. Rows are kept exactly as read,
// matched or not; nothing is dropped.
model PaymentAdvice {
  id           String       @id @default(cuid())
  adviceDate   DateTime
  bank         String?
  reference    String?
  total        Decimal // as printed on the advice
  rowsTotal    Decimal // sum of the rows read
  fileName     String
  filePath     String
  fileHash     String       @unique
  uploadedAt   DateTime     @default(now())
  uploadedById String
  uploadedBy   User         @relation("AdviceUploader", fields: [uploadedById], references: [id])
  appliedAt    DateTime?
  appliedById  String?
  appliedBy    User?        @relation("AdviceApplier", fields: [appliedById], references: [id])
  lines        AdviceLine[]

  @@index([adviceDate])
}

model AdviceLine {
  id          String        @id @default(cuid())
  adviceId    String
  advice      PaymentAdvice @relation(fields: [adviceId], references: [id], onDelete: Cascade)
  position    Int
  invoiceRef  String // as read, e.g. "M19-3423"
  voucher     String?
  invoiceDate DateTime?
  amount      Decimal
  withholding Decimal
  discount    Decimal
  net         Decimal
  result      AdviceResult
  invoiceId   String?
  invoice     ClaroInvoice? @relation(fields: [invoiceId], references: [id])
  appliedAt   DateTime?

  @@index([adviceId])
  @@index([invoiceId])
}

model PreCertSheet {
  id                    String     @id @default(cuid())
  docId                 String
  doc                   JafInvoice @relation(fields: [docId], references: [id])
  version               Int
  supersededAt          DateTime? // null = active sheet
  avisoNumber           String?
  certifiedAddress      String
  title                 String
  issuedOn              DateTime // "Fecha": the field update date
  lines                 Json // PreCertLine[] — see app/lib/service-lines.ts
  priceListRevision     String?
  total                 Decimal
  sigSupervisorUserId   String?
  sigSupervisorName     String?
  sigSupervisorImage    String? // base64 data URL
  sigSupervisorAt       DateTime?
  sigSubcontractorCode  String? // brigade code
  sigSubcontractorName  String?
  sigSubcontractorImage String?
  sigSubcontractorAt    DateTime?
  sigClaroName          String?
  sigClaroImage         String?
  sigClaroScanPath      String?
  sigClaroAt            DateTime?
  pdfPath               String?
  issuedAt              DateTime   @default(now())
  issuedById            String
  issuedBy              User       @relation(fields: [issuedById], references: [id])

  @@unique([docId, version])
  @@index([docId, supersededAt])
  @@map("pre_cert_sheet")
}

model PaymentRecord {
  id           String      @id @default(cuid())
  jobId        String
  job          JafInvoice  @relation(fields: [jobId], references: [id])
  type         PaymentType
  amount       Decimal
  date         DateTime
  recordedById String
  recordedBy   User        @relation(fields: [recordedById], references: [id])
  note         String?
  createdAt    DateTime    @default(now())

  @@unique([jobId, type])
  @@index([jobId, type])
  @@map("payment_record")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  docId     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedById String
  updatedBy   User     @relation("SystemSettings", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// Module 1 tables — schema defined now, routes built later
model Brigade {
  id           String   @id @default(cuid())
  name         String
  code         String?  @unique // Carmen's contractor/payroll number, e.g. "204"
  area         String? // CENTRAL, METRO, NORTE, OESTE, SUR
  supervisorId String?
  supervisor   User?    @relation("BrigadeSupervisor", fields: [supervisorId], references: [id])
  leadName     String?
  phone        String?
  memberIds    String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices           JafInvoice[]
  contractorAccounts ContractorAccount[]

  @@index([active])
  @@index([supervisorId])
}

model ContractorAccount {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  brigadeId String?
  brigade   Brigade? @relation(fields: [brigadeId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  invoices JafInvoice[]

  runAccounts PayrollRunAccount[]

  @@index([active])
}

model PayrollRun {
  id                  String    @id @default(cuid())
  label               String
  generatedAt         DateTime  @default(now())
  generatedById       String
  generatedBy         User      @relation("PayrollRunGenerator", fields: [generatedById], references: [id])
  // A request is a draft on Lissette's desk until she sends it; Carmen only
  // ever sees sent ones.
  sentAt              DateTime?
  sentById            String?
  sentBy              User?     @relation("PayrollRunSender", fields: [sentById], references: [id])
  paidAt              DateTime?
  paidById            String?
  paidBy              User?     @relation("PayrollRunPaidBy", fields: [paidById], references: [id])
  evidencePath        String?
  confirmedByFallback Boolean   @default(false)
  // Reversal is an admin-only action planned for Phase 5 (finance q&a 15.5).
  // Nothing writes these three columns yet; they are kept now so that phase
  // does not need another migration. Open-run queries already filter on
  // `reversedAt: null`.
  reversedAt          DateTime?
  reversedById        String?
  reversedBy          User?     @relation("PayrollRunReversedBy", fields: [reversedById], references: [id])
  reverseReason       String?

  invoices JafInvoice[]

  accounts PayrollRunAccount[]

  @@index([generatedAt])
}

// One row per contractor account in a payroll run: the comptroller's per-account
// "paid" tick. PayrollRun.paidAt is set when the last of these is ticked.
model PayrollRunAccount {
  id                  String            @id @default(cuid())
  payrollRunId        String
  payrollRun          PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  contractorAccountId String
  contractorAccount   ContractorAccount @relation(fields: [contractorAccountId], references: [id])
  paidAt              DateTime?
  paidById            String?
  paidBy              User?             @relation("PayrollRunAccountPaidBy", fields: [paidById], references: [id])
  confirmedByFallback Boolean           @default(false)
  createdAt           DateTime          @default(now())

  @@unique([payrollRunId, contractorAccountId])
  @@index([payrollRunId])
}

model Van {
  id                   String   @id @default(cuid())
  name                 String
  installerId          String?  @unique
  installer            User?    @relation("VanInstaller", fields: [installerId], references: [id])
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  vanAssignmentHistory Json? // [{ installerId, from, to }] — append-only

  vanPars            VanPar[]
  stockMovements     StockMovement[]
  installCompletions InstallCompletion[]
  restockRequests    RestockRequest[]

  @@index([active])
}

model InstallerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation("InstallerProfile", fields: [userId], references: [id], onDelete: Cascade)
  jafNumber String
  toaNumber String   @unique
  region    String?
  createdAt DateTime @default(now())

  @@map("installer_profile")
}

model VanPar {
  id            String @id @default(cuid())
  vanId         String
  van           Van    @relation(fields: [vanId], references: [id], onDelete: Cascade)
  serviceCodeId String
  parQty        Int

  @@unique([vanId, serviceCodeId])
  @@map("van_par")
}

model LimitTable {
  id            String @id @default(cuid())
  bracketFt     Int
  serviceCodeId String
  qty           Int

  @@unique([bracketFt, serviceCodeId])
  @@index([bracketFt])
  @@map("limit_table")
}

model SerialLocation {
  id            String          @id @default(cuid())
  serial        String          @unique
  serviceCodeId String
  status        SerialStatus
  condition     SerialCondition @default(NEW)
  currentRef    String // warehouseId | vanId | completionId
  since         DateTime        @default(now())

  @@index([status, currentRef])
  @@map("serial_location")
}

// stock_movement_location_ck (exactly one of vanId/warehouseId) is a hand-maintained CHECK in the warehouse_foundation migration — Prisma cannot express it; preserve it on any future migration hand-edit.
model StockMovement {
  id                String            @id @default(cuid())
  vanId             String?
  van               Van?              @relation(fields: [vanId], references: [id], onDelete: Restrict)
  warehouseId       String?
  warehouse         Warehouse?        @relation("WarehouseMovements", fields: [warehouseId], references: [id], onDelete: Restrict)
  kind              MovementKind      @default(SERIAL)
  serviceCodeId     String
  qty               Int
  serial            String?
  type              StockMovementType
  refCompletionId   String?
  refSwapId         String?
  refRestockId      String?
  refRepairBatchId  String?
  refRepairIntakeId String?
  refDeliveryId     String?
  refDocId          String?
  note              String? // audit note/reason: DISPOSITION / batch-void / triage-correction (Spec A), ADJUST / STARTING_BALANCE (Spec B)
  byUserId          String
  byUser            User              @relation("StockMovements", fields: [byUserId], references: [id])
  at                DateTime          @default(now())

  @@index([vanId, serviceCodeId])
  @@index([serial])
  @@index([warehouseId, serviceCodeId])
  @@map("stock_movement")
}

model RepairBatch {
  id             String            @id @default(cuid())
  warehouseId    String
  warehouse      Warehouse         @relation("WarehouseRepairBatches", fields: [warehouseId], references: [id])
  status         RepairBatchStatus @default(SENT)
  createdById    String
  createdBy      User              @relation("RepairBatchCreator", fields: [createdById], references: [id])
  sentAt         DateTime
  documentPath   String?
  claroReference String?
  notes          String?
  voidedById     String?
  voidedBy       User?             @relation("RepairBatchVoider", fields: [voidedById], references: [id])
  voidedAt       DateTime?
  voidReason     String?

  @@index([warehouseId, status])
}

model RepairIntake {
  id             String    @id @default(cuid())
  warehouseId    String
  warehouse      Warehouse @relation("WarehouseRepairIntakes", fields: [warehouseId], references: [id])
  receivedById   String
  receivedBy     User      @relation("RepairIntakeReceiver", fields: [receivedById], references: [id])
  receivedAt     DateTime
  declaredCount  Int
  documentPath   String?
  mismatchNote   String?
  claroReference String?
  notes          String?

  @@index([warehouseId])
}

model StockDelivery {
  id           String    @id @default(cuid())
  warehouseId  String
  warehouse    Warehouse @relation("WarehouseStockDeliveries", fields: [warehouseId], references: [id])
  receivedById String
  receivedBy   User      @relation("StockDeliveryReceiver", fields: [receivedById], references: [id])
  receivedAt   DateTime  @default(now())
  reference    String?
  notes        String?

  @@index([warehouseId, receivedAt])
}

model StockSnapshot {
  id            String    @id @default(cuid())
  warehouseId   String
  warehouse     Warehouse @relation("WarehouseStockSnapshots", fields: [warehouseId], references: [id])
  asOfDate      DateTime
  generatedById String
  generatedBy   User      @relation("StockSnapshotGenerator", fields: [generatedById], references: [id])
  generatedAt   DateTime  @default(now())
  documentPath  String?
  csvPath       String?

  @@index([warehouseId, asOfDate])
}

model IdempotencyKey {
  key       String   @id
  scope     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model InstallCompletion {
  id                String           @id @default(cuid())
  idempotencyKey    String           @unique // client-generated; blocks offline double-submit
  claroOrderNo      String
  installerId       String
  installer         User             @relation("InstallerCompletions", fields: [installerId], references: [id])
  vanId             String
  van               Van              @relation(fields: [vanId], references: [id])
  status            CompletionStatus @default(SUBMITTED)
  address           String
  addressEditLog    Json?
  gpsLat            Float?
  gpsLng            Float?
  dropFt            Int?
  accessories       Json?
  groundRod         Boolean          @default(true)
  coaxFt            Int?
  serialInstalled   String?
  serialUnreadable  Boolean          @default(false)
  serialNotOnVan    Boolean          @default(false)
  modelResolved     String?
  formPhotoPath     String?
  extraPhotoPaths   String[]
  sigInstaller      String?
  sigInstallerAt    DateTime?
  submittedAt       DateTime?
  installedAt       DateTime?
  completionPdfPath String?
  createdAt         DateTime         @default(now())
  swapEvents        SwapEvent[]

  @@index([installerId, createdAt])
  @@index([claroOrderNo])
  @@map("install_completion")
}

model SwapEvent {
  id                     String            @id @default(cuid())
  completionId           String
  completion             InstallCompletion @relation(fields: [completionId], references: [id])
  serialOut              String
  serialOutPhotoPath     String?
  serialOutMatchedRecord Boolean           @default(true)
  reason                 SwapReason
  serialIn               String
  serialInPhotoPath      String?
  serialInNotOnVan       Boolean           @default(false)
  newClaroOrderNo        String?
  daysSinceInstall       Int
  submittedAt            DateTime          @default(now())
  byInstallerId          String
  byInstaller            User              @relation("InstallerSwaps", fields: [byInstallerId], references: [id])

  @@index([completionId])
  @@map("swap_event")
}

model PaymentRequest {
  id               String               @id @default(cuid())
  kind             PaymentRequestKind
  completionId     String?
  swapId           String?
  installerId      String
  installer        User                 @relation("InstallerPaymentRequests", fields: [installerId], references: [id])
  status           PaymentRequestStatus @default(READY)
  missing          String[]
  daysSinceInstall Int?
  attachments      Json?
  paidAt           DateTime?
  paidRef          String?
  paidByUserId     String?
  paidBy           User?                @relation("PaidPaymentRequests", fields: [paidByUserId], references: [id])
  createdAt        DateTime             @default(now())

  @@index([status, createdAt])
  @@index([installerId, createdAt])
  @@map("payment_request")
}

model RestockRequest {
  id           String        @id @default(cuid())
  vanId        String
  van          Van           @relation(fields: [vanId], references: [id])
  lines        Json // [{ serviceCodeId, qty }]
  status       RestockStatus @default(SUBMITTED)
  submittedAt  DateTime      @default(now())
  approvedById String?
  approvedBy   User?         @relation("RestockApprovals", fields: [approvedById], references: [id])
  releaseId    String?

  @@index([status, submittedAt])
  @@index([vanId, submittedAt])
  @@map("restock_request")
}

model BankSchedule {
  id            String    @id @default(cuid())
  number        Int       @unique @default(autoincrement())
  generatedAt   DateTime  @default(now())
  generatedById String
  generatedBy   User      @relation("BankScheduleGenerator", fields: [generatedById], references: [id])
  advanceRate   Decimal
  total         Decimal
  advanceAmount Decimal
  xlsxPath      String?
  // The PBCC batch: open until closed (by Lissette, or on its 100th packet),
  // closed until sent. `closedAt` null = the one open batch.
  closedAt      DateTime?
  closedById    String?
  closedBy      User?     @relation("BankScheduleCloser", fields: [closedById], references: [id])
  sentAt        DateTime?
  sentById      String?
  sentBy        User?     @relation("BankScheduleSender", fields: [sentById], references: [id])

  invoices JafInvoice[]

  @@index([generatedAt])
}
