  "private": true,
  "type": "module",
  "scripts": {
    "clean": "git clean -fdX --exclude=\"!.env\"",
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc",
    "check": "biome check app/ prisma/ tests/",
    "check:fix": "biome check --write app/ prisma/ tests/",
    "check:unused": "knip",
    "check:unused:fix": "knip --fix",
    "validate": "pnpm run typecheck && pnpm run check && pnpm run test && pnpm run check:unused",
    "typegen": "react-router typegen"
  },
