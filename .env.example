# Copy to .env and fill in real values. See docs/it-deployment-guide.md §5.
# If the DB password contains @ / ? # % & + = or a space, percent-encode it,
# or Prisma throws P1013. Run `node scripts/fix-db-url.mjs` to encode it for you.
DATABASE_URL="postgresql://jaf_app:PASSWORD@localhost:5432/jaf_operations?sslmode=disable"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The exact public URL users hit (scheme + host), e.g. https://jaf.internal.example.com
BETTER_AUTH_URL="http://localhost:5173"
# Persistent storage for photos, signatures, and generated PDFs — NOT /tmp in production
UPLOAD_DIR="/var/lib/jaf-operations/uploads"
# Outbound email for the Claro packet (Step 5 "Send to Claro supervisor"), sent over SMTP via
# nodemailer. All five must be set or sends are logged UNCONFIGURED and the supervisor uses
# "Mark as sent manually". Port 465 uses implicit TLS; other ports (587) upgrade with STARTTLS.
# SMTP_FROM is the sender, e.g. "IMS <packets@example.com>". Internal notification email
# (email.server.ts) is separate, best effort, and does not use these.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
# Feature flags
ENABLE_VARIANCE="false"

# Show the dashboard filter bar (Phase 3 hides it by default)
ENABLE_DASHBOARD_FILTERS="false"

