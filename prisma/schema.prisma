// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
	provider = "postgresql"
	extensions = [pg_trgm]
}

enum Role {
  SUPERVISOR
  CREW
  WAREHOUSE
  FINANCE
  ADMIN
  INSTALLER
  COMPTROLLER
  INSTALLER_SUPERVISOR
}

enum DocStatus {
  CREATED
  PREPPED
  SIGNED
  FIELD_UPDATED
  SUPERVISOR_APPROVED
  CLARO_UPLOADED
  LC_REQUEST_GENERATED
  CANCELLED
}

enum PaymentType {
  PBCC_ADVANCE
  CREW_PAYMENT
  CLARO_FINAL
}

enum PhotoTag {
  BEFORE
  AFTER
}

enum CatalogKind {
  SERVICE
  MATERIAL
}

enum Ownership {
  CLARO_CONSIGNED
  JAF_PURCHASED
  UNKNOWN
}

enum SerialStatus {
  WAREHOUSE
  VAN
  INSTALLED
  REMOVED_PENDING_RETURN
  RETURNED
  SENT_FOR_REPAIR
}

enum VanMovementType {
  PICKUP
  INSTALL
  SWAP_OUT
  SWAP_IN
  RETURN
  ADJUST
}

enum CompletionStatus {
  DRAFT
  SUBMITTED
}

enum SwapReason {
  HARDWARE
  INSTALL_DEFECT
  CUSTOMER
  LINE
  OTHER
}

enum PaymentRequestKind {
  INSTALL
  CALLBACK
}

enum PaymentRequestStatus {
  INCOMPLETE
  READY
  PAID
}

enum RestockStatus {
  DRAFT
  SUBMITTED
  NEEDS_SIGNOFF
  APPROVED
  PICKED
  RECEIVED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Admin-managed: the areas a SUPERVISOR is authorized to act in. This is
  // the sole source of a supervisor's authorization scope — never derive it
  // from Brigade.area/supervisorId, which are ordinary editable fields, not
  // an identity/authorization record. See supervisorAreas() in
  // app/lib/supervisor-scope.ts.
  supervisorAreas String[] @default([])

  // better-auth relations
  sessions  Session[]
  accounts  Account[]

  supervisedInvoices    JafInvoice[]         @relation("SupervisorDocs")
  preppedInvoices       JafInvoice[]         @relation("PreppedDocs")
  releasedInvoices      JafInvoice[]         @relation("ReleasedDocs")
  signedInvoices        JafInvoice[]         @relation("SignedDocs")
  completedInvoices     JafInvoice[]         @relation("CompletedDocs")
  overriddenInvoices    JafInvoice[]         @relation("OverriddenDocs")
   lcApprovedInvoices    JafInvoice[]         @relation("LcApprovedDocs")
   financeVerifiedInvoices JafInvoice[]       @relation("FinanceVerifiedDocs")
    closedReceivables     JafInvoice[]        @relation("ClosedReceivables")
    cancelledInvoices     JafInvoice[]        @relation("CancelledDocs")
    supervisedBrigades    Brigade[]           @relation("BrigadeSupervisor")
    releasedToFinanceInvoices JafInvoice[]    @relation("ReleasedToFinanceDocs")
   installedVan          Van?                 @relation("VanInstaller")
   systemSettings        SystemSetting[]      @relation("SystemSettings")
  auditTrail       AuditTrail[]
  photos           Photo[]
   notifications    Notification[]
   paymentRecords   PaymentRecord[]
   preCertSheets    PreCertSheet[]
   warehouseAssignments WarehouseAssignment[]

  installerProfile     InstallerProfile?   @relation("InstallerProfile")
  vanMovements         VanMovement[]       @relation("VanMovements")
  installCompletions   InstallCompletion[] @relation("InstallerCompletions")
  installerSwaps       SwapEvent[]         @relation("InstallerSwaps")
  paymentRequests      PaymentRequest[]    @relation("InstallerPaymentRequests")
  paidPaymentRequests  PaymentRequest[]    @relation("PaidPaymentRequests")
  restockApprovals     RestockRequest[]    @relation("RestockApprovals")

   @@index([role, active])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([value])
}

model Warehouse {
  id       String   @id @default(cuid())
  name     String
  zone     String
  location String?
  active   Boolean  @default(true)
 
  invoices             JafInvoice[]
  warehouseAssignments WarehouseAssignment[]

  @@index([active])
}

// Which staff are assigned to which warehouse, and who leads it.
// Consumed by both Warehouse specs; Spec A adds the requireWarehouseLead helper.
model WarehouseAssignment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  isLead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([userId, warehouseId])
  @@index([warehouseId, isLead])
}

model JafInvoice {
  id            String    @id @default(cuid())
  controlNumber String    @unique
  status        DocStatus @default(CREATED)

  // Supervisor fills at intake
  jobType             String
  jobAddressEstimated String
   estimatedMaterials  Json
   assignedCrewIds     String[]
   crewAssignmentHistory Json?    // [{ userIds, assignedById, assignedAt }] — recorded at assignment changes
   supervisorId        String
  supervisor          User     @relation("SupervisorDocs", fields: [supervisorId], references: [id])
  avisoNumber         String?
  createdAt           DateTime @default(now())

  // Warehouse prep (Step 2)
  preppedAt   DateTime?
  preppedById String?
   preppedBy   User?    @relation("PreppedDocs", fields: [preppedById], references: [id])
   prepChangedSincePrep Boolean @default(false)
   preppedMaterials  Json?
   materialsReturned Json?

   // Dual signature at warehouse pickup (Step 3) — materialsTaken locked after this
  // warehouseId set here, not at prep — crew may pull from a different zone warehouse
  warehouseId      String?
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  materialsTaken   Json?
  releaseSignature String?    // base64 — warehouse person signs (gives)
  releasedById     String?
  releasedBy       User?      @relation("ReleasedDocs", fields: [releasedById], references: [id])
  releaseSignedAt  DateTime?
  crewSignature    String?    // base64 — crew member signs (receives)
  signedById       String?
  signedBy         User?      @relation("SignedDocs", fields: [signedById], references: [id])
  signedAt         DateTime?

  // Admin override
  overriddenById    String?
  overriddenBy      User?    @relation("OverriddenDocs", fields: [overriddenById], references: [id])
  overrideSignature String?
  overrideAt        DateTime?
  overrideReason    String?

  // Cancellation (allowed any time before Finance closes; requires a reason)
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?    @relation("CancelledDocs", fields: [cancelledById], references: [id])

  // Send-back history: Supervisor→Crew and Finance→Supervisor. Array of
  // { fromStatus, toStatus, note, byUserId, createdAt } kept for audit.
  sendBackHistory    Json?

   // Crew field update (Step 4)
   jobAddressActual String?
   addressCorrections Json?    // [{ original, corrected, correctedById, correctedAt, gps? }]
   gpsCoordinates   Json?     // { lat, lng, accuracy, capturedAt }
   materialsUsed    Json?
   fieldNotes       String?
   startedAt        DateTime? // time on site start
   endedAt          DateTime? // time on site end
   completionSignature String? // base64 — crew lead signs completion
   completedById    String?
   completedBy      User?     @relation("CompletedDocs", fields: [completedById], references: [id])
   completionSignedAt DateTime?
   completedAt      DateTime?
   fieldSubmittedAt DateTime?

  // Supervisor approval + Claro submission (Step 5)
  supervisorApprovedAt DateTime?
  claroNotes           String?
  claroPdfPath         String?
  claroUploadedAt      DateTime?

   // Lissette generates LC (Step 6)
   lcRequestPdfPath String?
   lcGeneratedAt    DateTime?
   lcApprovedById   String?
   lcApprovedBy     User?     @relation("LcApprovedDocs", fields: [lcApprovedById], references: [id])

   // Finance pipeline (Phase 2)
   financeVerifiedAt      DateTime?
   financeVerifiedById    String?
   financeVerifiedBy      User?      @relation("FinanceVerifiedDocs", fields: [financeVerifiedById], references: [id])
   financeSendBackNotes   Json?      // [{ note, byUserId, createdAt }] — Finance→Supervisor Aviso issues
   pbccRequestPdfPath     String?
   pbccRequestSentAt      DateTime?
   karmenCopySentAt       DateTime?
   finalClaroDocPath      String?
   finalClaroUploadedAt   DateTime?

   // Payment tracking (receivables dashboard)
   advanceReceivedAt      DateTime?
   advanceAmount          Decimal?
   finalPaymentReceivedAt DateTime?
   finalPaymentAmount     Decimal?
   receivableClosedAt     DateTime?
   receivableClosedById   String?
   receivableClosedBy     User?     @relation("ClosedReceivables", fields: [receivableClosedById], references: [id])

   // Generated documents
   warehouseReceiptPath String?
   jafInvoicePdfPath    String?    // supervisor-generated JAF invoice (for the Claro Aviso)
   
   // Phase 3 - supervisor layer
   brigadeId              String?
   brigade                Brigade?  @relation(fields: [brigadeId], references: [id])
   jobDescription         String?
   serviceLines           Json?     // [{ serviceCodeId, claroCode, accountCode, name, qty }] ordered at intake
   installedServiceLines  Json?     // same shape, crew's installed qty
   jafInvoiceGeneratedAt  DateTime?
   jafInvoiceLines        Json?     // [{ serviceCodeId, claroCode, accountCode, name, unit, qty, unitPrice, lineAmount }]
   jafInvoiceLineTotal    Decimal?  // pre-IVU line sum
   avisoDocPath           String?   // uploaded Aviso PDF (distinct from claroPdfPath)
   avisoLines             Json?     // [{ serviceCodeId, claroCode, qty, unitPrice, lineAmount }]
   avisoLineTotal         Decimal?
   avisoMatchedAt         DateTime? // set only when the amount gate passes
   contractorAccountCode  String?   // copied from Brigade.code at sub-contractor signature
   releasedToFinanceAt    DateTime?
   releasedToFinanceById  String?
   releasedToFinanceBy    User?     @relation("ReleasedToFinanceDocs", fields: [releasedToFinanceById], references: [id])

   preCertSheets PreCertSheet[]
   auditTrail AuditTrail[]
   photos     Photo[]
   poLinks    PoLink[]
   paymentRecords PaymentRecord[]

  @@index([status, lcGeneratedAt])
  @@index([status, financeVerifiedAt, pbccRequestSentAt, advanceReceivedAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([brigadeId])
  @@index([releasedToFinanceAt])
  @@index([assignedCrewIds(ops: ArrayOps)], type: Gin)
  @@index([avisoNumber(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([jobAddressEstimated(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("jaf_invoice")
}

model AuditTrail {
  id        String     @id @default(cuid())
  docId     String
  doc       JafInvoice @relation(fields: [docId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  action    String   // e.g. "STATUS_CHANGED", "FIELD_UPDATED"
  diffJson  Json     // {field, before, after}
  timestamp DateTime   @default(now())

  @@index([docId, timestamp])
}

model Photo {
  id           String      @id @default(cuid())
  docId        String
  doc          JafInvoice  @relation(fields: [docId], references: [id])
  uploadedById String
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])
  localPath    String      // /var/jaf/uploads/photos/<docId>/<filename>
  takenAt      DateTime    @default(now())
  tag          PhotoTag?

  @@index([docId])
}

model ServiceCode {
  id                String      @id @default(cuid())
  claroCode         String      @unique // e.g. "34006428"
  name              String          // catalog description,  e.g. "TRANSFER STITCH DE POSTESMC"
  description       String?
  kind              CatalogKind @default(MATERIAL)
  unit              String?      // EA, FT, SQFT, TRAMO (SPAN); null when the catalog has none
  unitPrice         Decimal     // = jaf_price (what JAF      invoices Claro)
  claroBasePrice    Decimal?
  upliftFactor      Decimal?
  contractorPrice   Decimal?
  contractorFactor  Decimal?
  priceListRevision String?
  effectiveFrom     DateTime?
  accountCode       String?
  subAct            String?
  dept              String?
  profitCenter      String?
  act               String?
  costCenterCode    String?
  active            Boolean     @default(true)

  // Material-master extensions (Phase 0). All nullable/defaulted so existing rows are untouched.
  ownership        Ownership @default(UNKNOWN) // CLARO_CONSIGNED | JAF_PURCHASED | UNKNOWN — values blocked on Orlando; ships default
  reparadoCode     String?   // original SAP code -> its REPARADO claroCode
  countUnit        String?   // unit staff physically count in
  stockUnit        String?   // unit stock is held/reported in
  conversionFactor Decimal?  // countUnit -> stockUnit; 39 rows blocked on Orlando (null => derived stock figure stays hidden)
  canonicalName    String?   // one canonical name per SAP code; the 21 alternates stay search-only

  serialized   Boolean @default(false)
  serialPrefix String?

  @@index([kind, active])
}

model PoLink {
  id               String @id @default(cuid())
  docId            String
  doc              JafInvoice @relation(fields: [docId], references: [id])
  claroPONumber    String
  acceptanceNumber String?
  poDate           DateTime?
  amount           Decimal?
  createdAt        DateTime @default(now())

  @@index([docId])
}

model PreCertSheet {
  id                    String     @id @default(cuid())
  docId                 String
  doc                   JafInvoice @relation(fields: [docId], references: [id])
  version               Int
  supersededAt          DateTime?  // null = active sheet
  avisoNumber           String?
  certifiedAddress      String
  title                 String
  issuedOn              DateTime   // "Fecha": the field update date
  lines                 Json       // PreCertLine[] — see app/lib/service-lines.ts
  priceListRevision     String?
  total                 Decimal
  sigSupervisorUserId   String?
  sigSupervisorName     String?
  sigSupervisorImage    String?    // base64 data URL
  sigSupervisorAt       DateTime?
  sigSubcontractorCode  String?    // brigade code
  sigSubcontractorName  String?
  sigSubcontractorImage String?
  sigSubcontractorAt    DateTime?
  sigClaroName          String?
  sigClaroImage         String?
  sigClaroScanPath      String?
  sigClaroAt            DateTime?
  pdfPath               String?
  issuedAt              DateTime   @default(now())
  issuedById		String
  issuedBy              User       @relation(fields: [issuedById], references: [id])

  @@unique([docId, version])
  @@index([docId, supersededAt])
  @@map("pre_cert_sheet")
}

model PaymentRecord {
  id           String    @id @default(cuid())
  jobId        String
  job          JafInvoice @relation(fields: [jobId], references: [id])
  type         PaymentType
  amount       Decimal
  date         DateTime
  recordedById String
  recordedBy   User      @relation(fields: [recordedById], references: [id])
  note         String?
  createdAt    DateTime @default(now())

  @@index([jobId, type])
  @@unique([jobId, type])
  @@map("payment_record")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  docId     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedById String
  updatedBy   User     @relation("SystemSettings", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// Module 1 tables — schema defined now, routes built later
model Brigade {
  id           String   @id @default(cuid())
  name         String
  code         String?  @unique // Carmen's contractor/payroll number, e.g. "204"
  area         String?          // CENTRAL, METRO, NORTE, OESTE, SUR
  supervisorId String?
  supervisor   User?    @relation("BrigadeSupervisor", fields: [supervisorId], references: [id])
  leadName     String?
  phone        String?
  memberIds    String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices JafInvoice[]

  @@index([active])
  @@index([supervisorId])
}

model Van {
  id                      String   @id @default(cuid())
  name                    String
  installerId             String?  @unique
  installer               User?    @relation("VanInstaller", fields: [installerId], references: [id])
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  vanAssignmentHistory    Json?    // [{ installerId, from, to }] — append-only

  vanPars            VanPar[]
  vanMovements       VanMovement[]
  installCompletions InstallCompletion[]
  restockRequests    RestockRequest[]

  @@index([active])
}

model InstallerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation("InstallerProfile", fields: [userId], references: [id], onDelete: Cascade)
  jafNumber String
  toaNumber String   @unique
  region    String?
  createdAt DateTime @default(now())
  @@map("installer_profile")
}

model VanPar {
  id            String @id @default(cuid())
  vanId         String
  van           Van    @relation(fields: [vanId], references: [id], onDelete: Cascade)
  serviceCodeId String
  parQty        Int
  @@unique([vanId, serviceCodeId])
  @@map("van_par")
}

model LimitTable {
  id            String @id @default(cuid())
  bracketFt     Int
  serviceCodeId String
  qty           Int
  @@unique([bracketFt, serviceCodeId])
  @@index([bracketFt])
  @@map("limit_table")
}

model SerialLocation {
  id            String       @id @default(cuid())
  serial        String       @unique
  serviceCodeId String
  status        SerialStatus
  currentRef    String       // warehouseId | vanId | completionId
  since         DateTime     @default(now())
  @@index([status, currentRef])
  @@map("serial_location")
}

model VanMovement {
  id              String          @id @default(cuid())
  vanId           String
  van             Van             @relation(fields: [vanId], references: [id])
  serviceCodeId   String
  qty             Int
  serial          String?
  type            VanMovementType
  refCompletionId String?
  refSwapId       String?
  refRestockId    String?
  byUserId        String
  byUser          User            @relation("VanMovements", fields: [byUserId], references: [id])
  at              DateTime        @default(now())
  @@index([vanId, serviceCodeId])
  @@index([serial])
  @@map("van_movement")
}

model InstallCompletion {
  id                String           @id @default(cuid())
  idempotencyKey    String           @unique   // client-generated; blocks offline double-submit
  claroOrderNo      String
  installerId       String
  installer         User             @relation("InstallerCompletions", fields: [installerId], references: [id])
  vanId             String
  van               Van              @relation(fields: [vanId], references: [id])
  status            CompletionStatus @default(SUBMITTED)
  address           String
  addressEditLog    Json?
  gpsLat            Float?
  gpsLng            Float?
  dropFt            Int?
  accessories       Json?
  groundRod         Boolean          @default(true)
  coaxFt            Int?
  serialInstalled   String?
  serialUnreadable  Boolean          @default(false)
  serialNotOnVan    Boolean          @default(false)
  modelResolved     String?
  formPhotoPath     String?
  extraPhotoPaths   String[]
  sigInstaller      String?
  sigInstallerAt    DateTime?
  submittedAt       DateTime?
  installedAt       DateTime?
  completionPdfPath String?
  createdAt         DateTime         @default(now())
  swapEvents        SwapEvent[]
  @@index([installerId, createdAt])
  @@index([claroOrderNo])
  @@map("install_completion")
}

model SwapEvent {
  id                     String            @id @default(cuid())
  completionId           String
  completion             InstallCompletion @relation(fields: [completionId], references: [id])
  serialOut              String
  serialOutPhotoPath     String?
  serialOutMatchedRecord Boolean           @default(true)
  reason                 SwapReason
  serialIn               String
  serialInPhotoPath      String?
  serialInNotOnVan       Boolean           @default(false)
  newClaroOrderNo        String?
  daysSinceInstall       Int
  submittedAt            DateTime          @default(now())
  byInstallerId          String
  byInstaller            User              @relation("InstallerSwaps", fields: [byInstallerId], references: [id])
  @@index([completionId])
  @@map("swap_event")
}

model PaymentRequest {
  id               String               @id @default(cuid())
  kind             PaymentRequestKind
  completionId     String?
  swapId           String?
  installerId      String
  installer        User                 @relation("InstallerPaymentRequests", fields: [installerId], references: [id])
  status           PaymentRequestStatus @default(READY)
  missing          String[]
  daysSinceInstall Int?
  attachments      Json?
  paidAt           DateTime?
  paidRef          String?
  paidByUserId     String?
  paidBy           User?                @relation("PaidPaymentRequests", fields: [paidByUserId], references: [id])
  createdAt        DateTime             @default(now())
  @@index([status, createdAt])
  @@index([installerId, createdAt])
  @@map("payment_request")
}

model RestockRequest {
  id           String        @id @default(cuid())
  vanId        String
  van          Van           @relation(fields: [vanId], references: [id])
  lines        Json          // [{ serviceCodeId, qty }]
  status       RestockStatus @default(SUBMITTED)
  submittedAt  DateTime      @default(now())
  approvedById String?
  approvedBy   User?         @relation("RestockApprovals", fields: [approvedById], references: [id])
  releaseId    String?
  @@index([status, submittedAt])
  @@index([vanId, submittedAt])
  @@map("restock_request")
}
